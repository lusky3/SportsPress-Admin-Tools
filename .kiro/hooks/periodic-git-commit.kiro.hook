{
  "enabled": true,
  "name": "Periodic Git Commit & Push",
  "description": "Monitors all PHP, JavaScript, CSS, and markdown files for changes and periodically commits them with a descriptive message and pushes to the remote repository. ",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "**/*.php",
      "**/*.js",
      "**/*.css",
      "**/*.md",
      "**/*.txt",
      "**/*.json"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Files have been modified in the workspace. Please:\n1. Review the git status to see what files have changed\n2. Generate a clear, descriptive commit message that summarizes the changes made\n3. Stage all changes with 'git add .'\n4. Commit with the descriptive message\n5. Commits are GPG signed, use environment variable GPG_KEY for the unlock passphrase. Do not use echo for the GPG Key, Ue --passphrase \"$GPG_KEY\".\n6. Push to the remote repository with 'git push'\n\nMake sure the commit message follows best practices: use present tense, be specific about what changed, and mention the affected plugins/components."
  },
  "workspaceFolderName": "sportspress-admin-tools",
  "shortName": "periodic-git-commit"
}