# Files and directories excluded from the distributed plugin build.
# Mirrors the WordPress.org SVN "dotorg" exclusion model: anything listed
# here is stripped before packaging so it never ships to production.

# Dev tooling / VCS
/.git
/.github
.gitignore
.gitattributes
.distignore
.editorconfig

# Tests (never shipped)
/tests

# Build tooling
composer.json
composer.lock
phpcs.xml
phpunit.xml
phpunit.xml.dist

# Docs that don't belong in the distributed package
/docs
README.md
AGENTS.md
ARCHITECTURE.md
