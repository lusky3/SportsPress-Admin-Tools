# Files and directories excluded from the distributed plugin build.
# Mirrors the WordPress.org SVN "dotorg" exclusion model: anything listed
# here is stripped before packaging so it never ships to production.
#
# CRITICAL: tests/ holds dev-only debug scripts and the standalone unit-test
# suite; some self-bootstrap WordPress and must NEVER be web-reachable on a
# production install. docs/ has sample data that does not belong in the
# distributed package.

# Dev tooling / VCS
/.git
/.github
.gitignore
.gitattributes
.distignore
.editorconfig
.amazonq

# Tests, fixtures, and debug scripts (never shipped)
/tests

# Docs and sample data (never shipped)
/docs

# Build / dependency tooling
/node_modules
composer.json
composer.lock
package.json
package-lock.json
phpcs.xml
phpunit.xml
phpunit.xml.dist

# README-style assets that don't belong in the distributed package
assets/README*
AGENTS.md
